;
; BIND data file for delarioja.red reverse zone
; Fichero de zona inversa de delarioja.red para BIND
; por Fernando Barcina
;
$TTL    1d
$ORIGIN 1.168.192.in-addr.arpa.
@       IN      SOA     dns1.delarioja.red. fernando.delarioja.red. (
                 2020102801         ; Serial AñoMesDiaNumerocorrelativo
                         2h         ; Refresh
                         1h         ; Retry
                         2w         ; Expire
                         1d )       ; Negative Cache TTL
;
@             IN      NS      dns1.delarioja.red.
100           IN      PTR     delarioja.red.
100           IN      PTR     dns1.delarioja.red.
1             IN      PTR     dns2.delarioja.red.
10            IN      PTR     cliente10-red1.delarioja.red.
$GENERATE 20-50 $             IN      PTR     cliente$-red1.delarioja.red.
100           IN      PTR     correo.delarioja.red.
1             IN      PTR     correo2.delarioja.red.

$ORIGIN 2.168.192.in-addr.arpa.
100           IN      PTR     servidor2.delarioja.red.
$GENERATE 20-50 $             IN      PTR     cliente$-red2.delarioja.red.
