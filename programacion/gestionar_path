#!/bin/bash
# Fernando Barcina
# Modo de uso
# agregar_path /path/a/agregar

if [[ $# != 1 ]]; then
	echo -e "\e[1;33mModo de uso:\e[0m\n agregar_path \e[1;33m/path/a/agregar\e[0m"
else
	echo -e "PATH antes del cambio: \e[0;35m$PATH\e[0m"             # Imprime el estado de PATH antes de cambios
  if [[ $1 == '-d' ]]; then                                     # Si el parámeto es -d
     echo -e '\e[41mEliminar último directorio\e[49m'              # Imprime la instrucción que va a realizar
     PATH=`echo $PATH | sed -e 's/:[A-Za-z/]*$//g'`                # Elimina el último directorio de PATH
  else                                                          # Si es otro parámetro
     echo -e "Añadir directorio \e[43m$1\e[49m"                    # Imprime la instrucción que va a realizar
     export PATH=$PATH:$1                                          # Añade a PATH el directorio indicado por parámetros
  fi
  echo -e "PATH después del cambio: \e[0;34m$PATH\e[0m"
fi
