#!/bin/bash -x
# trabaja por defecto con el fichero bdreparto
while getopts "m:a:" OPCION
do
  # Donde $1 puede ser -m o -a
  OPCION=$OPTIND
  case $OPCION in
  -m) NUMEMP=$(grep $2 bdreparto | cut -d":" -f1)
  #otra manera de hacerlo:
  NOMBRE=$(grep $2 bdreparto | cut -d":" -f2)
  APELLIDO=$(grep $2 bdreparto | cut -d":" -f3)
  DNI=$(grep $2 bdreparto | cut -d":" -f4)
  SUELDO=$(grep $2 bdreparto | cut -d":" -f5)
  PUESTO=$(grep $2 bdreparto | cut -d":" -f6)
  #clear
  echo -e "N_Empleado\tNOMBRE\tAPELLIDO\tDNI\tPUESTO\tSUELDO"
  echo -e "$NUMEMP\t$NOMBRE\t$APELLIDO\t$DNI\t$PUESTO\t$SUELDO"
  ;;

  -a) NOMBRE=$(grep $2 bdreparto | cut -d":" -f2)
  APELLIDO=$(grep $2 bdreparto | cut -d":" -f3)
  DNI=$(grep $2 bdreparto | cut -d":" -f4)
  SUELDO=$(grep $2 bdreparto | cut -d":" -f5)
  PUESTO=$(grep $2 bdreparto | cut -d":" -f6)
      case $PUESTO in
      Director) SUELDO_ANUAL=$(( $SUELDO * 12 + 900 * 2 )) ;;
      Productor) SUELDO_ANUAL=$(( $SUELDO * 12 + 1500 * 2 )) ;;
      "Actor principal") SUELDO_ANUAL=$(( $SUELDO * 12 + 854 * 2 )) ;;
      Actor) SUELDO_ANUAL=$(( $SUELDO * 12 + 700 * 2 )) ;;
      Guionista) SUELDO_ANUAL=$(( $SUELDO * 12 + 500 * 2 )) ;;
      esac
  #clear
  echo "NOMBRE APELLIDO DNI SUELDO MES SUELDO ANUAL"
  echo "$NOMBRE $APELLIDO $DNI $SUELDO euros $SUELDO_ANUAL euros"
  ;;
  *) echo "Oye te has equivocado de opción, solo puedes elegir o -m o -a"
  ;;
  esac
done
