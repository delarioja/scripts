#!/bin/bash
tee bdreparto << 'EOF'
NºEmpleado:Nombre:Apellido:DNI:SueldoMensual(Euros):Puesto
100:Neo:Elegido:73452765D:1456:Ingeniero
101:Trinity:Olasolo:23652899G:1223:Jefe Produccion
102:Niobe:Ochagavia:73422161L:966:Peon
103:Morfeo:Ortiz:54288715H:1198:Oficial 1A
104:Bruce:Banner:56376544K:1823:Director
EOF

# trabaja por defecto con el fichero bdreparto
while getopts "m:a:" opcion
do
# Donde $1 puede ser -m o -a
opcion=$1
case "$opcion" in
-m) NUMEMP=`cat bdreparto | grep $2 | cut -d":" -f1`
#otra manera de hacerlo:
NOMBRE=`grep $2 bdreparto | cut -d":" -f2`
APELLIDO=`cat bdreparto | grep $2 | cut -d":" -f3`
DNI=`cat bdreparto | grep $2 | cut -d":" -f4`
SUELDO=`cat bdreparto | grep $2 | cut -d":" -f5`
PUESTO=`cat bdreparto | grep $2 | cut -d":" -f6`
clear
echo -e "N_Empleado\tNOMBRE\tAPELLIDO\tDNI\tPUESTO\tSUELDO"
echo -e "$NUMEMP\t$NOMBRE\t$APELLIDO\t$DNI\t$PUESTO\t$SUELDO"
;;

-a) NOMBRE=`cat bdreparto | grep $2 | cut -d":" -f2`
APELLIDO=`cat bdreparto | grep $2 | cut -d":" -f3`
DNI=`cat bdreparto | grep $2 | cut -d":" -f4`
SUELDO=`cat bdreparto | grep $2 | cut -d":" -f5`
PUESTO=`cat bdreparto | grep $2 | cut -d":" -f6`
    case $PUESTO in
    Director) SUELDO_ANUAL=`expr $SUELDO "*" 12 + 900 "*" 2` ;;
    Productor) SUELDO_ANUAL=`expr $SUELDO "*" 12 + 1500 "*" 2` ;;
    "Actor principal") SUELDO_ANUAL=`expr $SUELDO "*" 12 + 854 "*" 2` ;;
    Actor) SUELDO_ANUAL=`expr $SUELDO "*" 12 + 700 "*" 2` ;;
    Guionista) SUELDO_ANUAL=`expr $SUELDO "*" 12 + 500 "*" 2` ;;
    esac
clear
echo "NOMBRE APELLIDO DNI SUELDO MES SUELDO ANUAL"
echo "$NOMBRE $APELLIDO $DNI $SUELDO euros $SUELDO_ANUAL euros"
;;
*) echo "Oye te has equivocado de opción, solo puedes elegir o -m o -a"
;;
esac
done
